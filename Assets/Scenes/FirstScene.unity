  m_text: "\u0413\u0430\u0437\u043E\u0430\u043D\u0430\u043B\u0438\u0437\u0430\u0442\u043E\u0440
    \u043D\u0430 \u0433\u0440\u0443\u0434\u0438 \u0441\u0438\u0433\u043D\u0430\u043B\u0438\u0437\u0438\u0440\u0443\u0435\u0442
    \u043E\u0431 \u043E\u043F\u0430\u0441\u043D\u044B\u0445 \u0433\u0430\u0437\u0430\u0445
    \u0432 \u0432\u043E\u0437\u0434\u0443\u0445\u0435, \u0432 \u0442\u043E\u043C
    \u0447\u0438\u0441\u043B\u0435 \u043E\u0431 \u0443\u0433\u0430\u0440\u043D\u043E\u043C
    \u0433\u0430\u0437\u0435 (\u0421\u041E). \u0427\u0430\u0441\u0442\u044B\u0439
    \u0433\u0440\u043E\u043C\u043A\u0438\u0439 \u0441\u0438\u0433\u043D\u0430\u043B
    \u2014 \u043F\u043E\u0432\u044B\u0448\u0435\u043D\u043D\u0430\u044F \u043A\u043E\u043D\u0446\u0435\u043D\u0442\u0440\u0430\u0446\u0438\u044F:
    \u043F\u0440\u0435\u043A\u0440\u0430\u0442\u0438\u0442\u0435 \u043E\u0441\u043C\u043E\u0442\u0440
    \u0438 \u043F\u043E\u043A\u0438\u043D\u044C\u0442\u0435 \u0437\u043E\u043D\u0443."
