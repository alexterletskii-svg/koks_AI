  stepText: "\u0428\u0430\u0433 5"
  title: "\u0414\u0440\u0443\u0433\u0430\u044F \u0441\u0442\u043E\u0440\u043E\u043D\u0430
    \u043F\u0435\u0447\u0438"
  description: "\u041F\u0440\u0438 \u043E\u0441\u043C\u043E\u0442\u0440\u0435 \u0433\u0430\u0437\u043E\u0432\u0449\u0438\u043A
    \u043A\u043E\u043A\u0441\u043E\u0432\u044B\u0445 \u043F\u0435\u0447\u0435\u0439
    \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442 \u0434\u0432\u0435
    \u0441\u0442\u043E\u0440\u043E\u043D\u044B \u043F\u0435\u0447\u0438. \u0412\u0442\u043E\u0440\u0430\u044F
    \u0441\u0442\u043E\u0440\u043E\u043D\u0430 \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0435\u0442\u0441\u044F
    \u043F\u043E \u043F\u0440\u0438\u043C\u0435\u0440\u0443 \u0442\u043E\u0439, \u0447\u0442\u043E
    \u0432\u044B \u043F\u0440\u043E\u0448\u043B\u0438 \u0441\u0435\u0439\u0447\u0430\u0441."
  checksHeader: "\u0427\u0442\u043E \u0434\u0435\u043B\u0430\u0442\u044C"
  checks:
  - "\u041F\u043E\u0432\u0442\u043E\u0440\u0438\u0442\u0435 \u043E\u0441\u043C\u043E\u0442\u0440
