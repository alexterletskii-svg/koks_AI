  m_Script: {fileID: 11500000, guid: 0e88f7188f688c9438cfb30c15b3ad26, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KoksUI.StepWindow
  stepText: "\u0428\u0430\u0433 4"
  title: "\u041E\u0441\u043C\u043E\u0442\u0440 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F"
  description: "\u041D\u0430\u0432\u043E\u0434\u0438\u0442\u0435 \u043B\u0443\u0447
    \u043D\u0430 \u043C\u0430\u0440\u043A\u0435\u0440\u044B \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435
    2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B. \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
    \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435 \u043F\u043E
    \u0441\u043F\u0438\u0441\u043A\u0443."
  checksHeader: "\u0427\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C"
  checks:
  - "\u041F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043F\u0440\u043E\u0431\u043E\u043A
    \u0441\u0442\u043E\u043F\u043E\u0440\u043D\u044B\u0445 \u043A\u0440\u0430\u043D\u043E\u0432"
  - "\u0421\u043E\u0435\u0434\u0438\u043D\u0435\u043D\u0438\u044F \u0440\u044B\u0447\u0430\u0433\u043E\u0432
    \u043A\u0430\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u044B\u0445 \u043A\u0440\u0430\u043D\u043E\u0432
    \u0441\u043E \u0448\u0442\u0430\u043D\u0433\u043E\u0439 \u043A\u0430\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u043E\u0439
    \u043B\u0435\u0431\u0451\u0434\u043A\u0438"
  - "\u041F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043A\u0440\u044B\u0448\u0435\u043A
    \u0443\u0441\u0442\u0440\u043E\u0439\u0441\u0442\u0432\u0430 \u043E\u0431\u0435\u0437\u0433\u0440\u0430\u0444\u0438\u0447\u0438\u0432\u0430\u043D\u0438\u044F"
  - "\u0412\u043D\u0435\u0448\u043D\u044F\u044F \u043F\u043E\u0432\u0435\u0440\u0445\u043D\u043E\u0441\u0442\u044C
    \u0433\u0430\u0437\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u043E\u0432. \u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442
    \u0437\u0430\u043F\u0438\u0441\u0430\u0442\u044C \u0432 \u0436\u0443\u0440\u043D\u0430\u043B"
  - "\u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u0448\u0442\u0430\u043D\u0433
    \u043A\u0430\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u043E\u0433\u043E \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u0430"
  - "\u0421\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u0435 \u043A\u0430\u043D\u0430\u0442\u043E\u0432
    \u0438 \u0436\u0438\u043C\u043A\u043E\u0432 \u043A\u0430\u043D\u0430\u0442\u043E\u0432
    \u043A\u0430\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u043E\u0433\u043E \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u0430"
  buttonText: "\u041F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u043A
    \u043E\u0441\u043C\u043E\u0442\u0440\u0443"
