  m_Script: {fileID: 11500000, guid: 0e88f7188f688c9438cfb30c15b3ad26, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KoksUI.StepWindow
  stepText: "\u0413\u0430\u0437\u043E\u0432\u044B\u0439 \u0442\u043E\u043D\u043D\u0435\u043B\u044C"
  title: "\u0412\u044B \u0432 \u0433\u0430\u0437\u043E\u0432\u043E\u043C \u0442\u043E\u043D\u043D\u0435\u043B\u0435"
  description: "\u0417\u0434\u0435\u0441\u044C \u043D\u0443\u0436\u043D\u043E \u043E\u0441\u043C\u043E\u0442\u0440\u0435\u0442\u044C
    \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435. \u0418\u0434\u0438\u0442\u0435
    \u043A \u0441\u0438\u043D\u0438\u043C \u043A\u0440\u0443\u0433\u0430\u043C: \u0443
    \u043A\u0430\u0436\u0434\u043E\u0433\u043E \u0431\u0443\u0434\u0435\u0442 \u0438\u043D\u0444\u043E\u0440\u043C\u0430\u0446\u0438\u044F
    \u043E \u0442\u043E\u043C, \u0447\u0442\u043E \u0438 \u043A\u0430\u043A \u043E\u0441\u043C\u0430\u0442\u0440\u0438\u0432\u0430\u0442\u044C."
  checksHeader: "\u041A\u0430\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C"
  checks:
  - "\u041F\u043E\u0434\u043E\u0439\u0434\u0438\u0442\u0435 \u043A \u0441\u0438\u043D\u0435\u043C\u0443
