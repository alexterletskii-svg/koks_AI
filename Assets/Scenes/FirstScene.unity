  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KoksUI.StepWindow
  stepText: "\u0428\u0430\u0433 8"
  title: "\u0421\u0442\u043E\u0447\u043D\u044B\u0435 \u043B\u0438\u043D\u0438\u0438
    \u0433\u0430\u0437\u043E\u043F\u043E\u0434\u043E\u0433\u0440\u0435\u0432\u0430\u0442\u0435\u043B\u044F"
  description: "\u041D\u0443\u0436\u043D\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C
    \u0440\u0430\u0431\u043E\u0442\u043E\u0441\u043F\u043E\u0441\u043E\u0431\u043D\u043E\u0441\u0442\u044C
    \u0441\u0442\u043E\u0447\u043D\u044B\u0445 \u043B\u0438\u043D\u0438\u0439 \u0433\u0430\u0437\u043E\u043F\u043E\u0434\u043E\u0433\u0440\u0435\u0432\u0430\u0442\u0435\u043B\u044F."
  checksHeader: "\u0427\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C"
  checks:
  - "\u041E\u0442\u043A\u0440\u043E\u0439\u0442\u0435 \u043A\u0440\u0430\u043D: \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435
    \u043B\u0443\u0447 \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435"
  - "\u0423\u0431\u0435\u0434\u0438\u0442\u0435\u0441\u044C, \u0447\u0442\u043E \u0432\u043E\u0434\u0430
    \u0438\u0434\u0451\u0442 \u043F\u043E \u043B\u0438\u043D\u0438\u0438"
  - "\u0417\u0430\u043A\u0440\u043E\u0439\u0442\u0435 \u043A\u0440\u0430\u043D \u0441\u0430\u043C\u0438:
    \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435 \u043B\u0443\u0447 \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435"
  buttonText: "\u041F\u0440\u0438\u0441\u0442\u0443\u043F\u0438\u0442\u044C \u043A
    \u043E\u0441\u043C\u043E\u0442\u0440\u0443"
