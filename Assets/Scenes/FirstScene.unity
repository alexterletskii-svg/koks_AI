  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KoksUI.StepWindow
  stepText: "\u0428\u0430\u0433 6"
  title: "\u041E\u043F\u043E\u0440\u043D\u044B\u0435 \u0440\u043E\u043B\u0438\u043A\u0438"
  description: "\u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u043C \u044D\u0442\u0430\u043F\u043E\u043C
    \u043E\u0441\u043C\u043E\u0442\u0440\u0430 \u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043E\u0441\u043C\u043E\u0442\u0440 \u0441\u043E\u0441\u0442\u043E\u044F\u043D\u0438\u044F
    \u0446\u0435\u043B\u043E\u0441\u0442\u043D\u043E\u0441\u0442\u0438 \u0431\u043B\u043E\u0447\u043A\u043E\u0432
    \u0438 \u043E\u043F\u043E\u0440\u043D\u044B\u0445 \u0440\u043E\u043B\u0438\u043A\u043E\u0432
    \u043A\u0430\u043D\u0442\u043E\u0432\u043E\u0447\u043D\u043E\u0433\u043E \u043C\u0435\u0445\u0430\u043D\u0438\u0437\u043C\u0430.
    \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u0440\u043E\u043B\u0438\u043A\u0438,
    \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0435 \u0440\u043E\u043C\u0431\u0438\u043A\u0430\u043C\u0438,
