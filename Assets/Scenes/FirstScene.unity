--- !u!114 &1858744870
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1858744869}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 332be2ba2ca27274aae1cb07212b93df, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KoksUI.ExamController
  forceExam: 0
  inspectSeconds: 2
  doorSeconds: 1.5
  condensateSeconds: 3
  door: {fileID: 0}
  condensate: {fileID: 0}
  drain: {fileID: 0}
  journal: {fileID: 1795332550}
  tunnelTrigger: {fileID: 0}
  result: {fileID: 958272508}
  journalIcon: {fileID: 456605448}
  ringRoot: {fileID: 1875114998}
  ringFill: {fileID: 1609616032}
  introStatus: "\u042D\u043A\u0437\u0430\u043C\u0435\u043D \u043D\u0430\u0447\u0430\u043B\u0441\u044F"
  introTitle: "\u042D\u043A\u0437\u0430\u043C\u0435\u043D: \u043E\u0441\u043C\u043E\u0442\u0440
    \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u044F \u0442\u043E\u043D\u043D\u0435\u043B\u0435\u0439
    \u043A\u043E\u043A\u0441\u043E\u0432\u043E\u0439 \u0431\u0430\u0442\u0430\u0440\u0435\u0438"
  introDescription: "\u041E\u0441\u043C\u043E\u0442\u0440 \u043F\u0440\u043E\u0432\u043E\u0434\u0438\u0442\u0441\u044F
    \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E,
    \u0431\u0435\u0437 \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043E\u043A. \u0412\u0440\u0435\u043C\u044F
    \u0437\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F
    \u0441 \u043C\u043E\u043C\u0435\u043D\u0442\u0430 \u0432\u0445\u043E\u0434\u0430
    \u0432 \u0433\u0430\u0437\u043E\u0432\u044B\u0439 \u0442\u043E\u043D\u043D\u0435\u043B\u044C."
  introBullets:
  - "\u041E\u0441\u043C\u043E\u0442\u0440 \u0437\u0430\u0441\u0447\u0438\u0442\u044B\u0432\u0430\u0435\u0442\u0441\u044F,
    \u0435\u0441\u043B\u0438 \u0434\u0435\u0440\u0436\u0430\u0442\u044C \u043B\u0443\u0447
    \u043D\u0430 \u0434\u0435\u0442\u0430\u043B\u0438 2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B"
  - "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u043E\u0441\u043C\u043E\u0442\u0440\u0430
    \u0437\u0430\u043F\u0438\u0448\u0438\u0442\u0435 \u0432 \u0436\u0443\u0440\u043D\u0430\u043B"
  - "\u0417\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0435 \u043E\u0441\u043C\u043E\u0442\u0440,
    \u043D\u0430\u0432\u0435\u0434\u044F \u043B\u0443\u0447 \u043D\u0430 \u0434\u0432\u0435\u0440\u044C
    \u0432\u044B\u0445\u043E\u0434\u0430"
  tunnelStep: "\u042D\u043A\u0437\u0430\u043C\u0435\u043D"
  tunnelTitle: "\u0412\u044B \u0432 \u0433\u0430\u0437\u043E\u0432\u043E\u043C \u0442\u043E\u043D\u043D\u0435\u043B\u0435"
  tunnelDescription: "\u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435 \u043E\u0431\u043E\u0440\u0443\u0434\u043E\u0432\u0430\u043D\u0438\u0435
    \u0441\u0430\u043C\u043E\u0441\u0442\u043E\u044F\u0442\u0435\u043B\u044C\u043D\u043E:
    \u043F\u043E\u0434\u0441\u043A\u0430\u0437\u043E\u043A \u043D\u0435\u0442. \u041A\u043E\u0433\u0434\u0430
    \u0437\u0430\u043A\u043E\u043D\u0447\u0438\u0442\u0435, \u043D\u0430\u0432\u0435\u0434\u0438\u0442\u0435
    \u043B\u0443\u0447 \u043D\u0430 \u0434\u0432\u0435\u0440\u044C \u0432\u044B\u0445\u043E\u0434\u0430."
  tunnelChecksHeader: "\u041A\u0430\u043A \u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C"
  tunnelChecks:
  - "\u0414\u0435\u0440\u0436\u0438\u0442\u0435 \u043B\u0443\u0447 \u043D\u0430 \u0434\u0435\u0442\u0430\u043B\u0438
    2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B"
  - "\u0420\u0435\u0437\u0443\u043B\u044C\u0442\u0430\u0442\u044B \u0437\u0430\u043F\u0438\u0448\u0438\u0442\u0435
    \u0432 \u0436\u0443\u0440\u043D\u0430\u043B"
  - "\u0417\u0430\u0432\u0435\u0440\u0448\u0438\u0442\u0435 \u043E\u0441\u043C\u043E\u0442\u0440
    \u0443 \u0434\u0432\u0435\u0440\u0438"
  tunnelButton: "\u041D\u0430\u0447\u0430\u0442\u044C \u043E\u0441\u043C\u043E\u0442\u0440"
