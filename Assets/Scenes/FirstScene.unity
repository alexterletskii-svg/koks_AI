  group: "\u0413\u0430\u0437\u043E\u043F\u0440\u043E\u0432\u043E\u0434\u044B"
  title: "\u0413\u0430\u0437\u043E\u043F\u0440\u043E\u0432\u043E\u0434 2"
  text: "\u041F\u0440\u043E\u0438\u0437\u0432\u0435\u0441\u0442\u0438 \u043E\u0441\u043C\u043E\u0442\u0440
