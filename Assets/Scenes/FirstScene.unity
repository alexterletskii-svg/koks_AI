  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::KoksUI.StepWindow
  stepText: "\u0428\u0430\u0433 1"
  title: "\u0413\u0430\u0437\u043E\u0432\u043E\u0437\u0434\u0443\u0448\u043D\u044B\u0435
    \u043A\u043B\u0430\u043F\u0430\u043D\u044B"
  description: "\u0412\u044B \u0443 \u0433\u0430\u0437\u043E\u0432\u043E\u0437\u0434\u0443\u0448\u043D\u044B\u0445
    \u043A\u043B\u0430\u043F\u0430\u043D\u043E\u0432. \u041E\u0441\u043C\u043E\u0442\u0440\u0438\u0442\u0435
    \u043E\u0431\u0430 \u043A\u043B\u0430\u043F\u0430\u043D\u0430: \u043D\u0430\u0432\u043E\u0434\u0438\u0442\u0435
    \u043B\u0443\u0447 \u043D\u0430 \u043E\u0442\u043C\u0435\u0447\u0435\u043D\u043D\u044B\u0435
    \u043C\u0430\u0440\u043A\u0435\u0440\u044B \u0438 \u0434\u0435\u0440\u0436\u0438\u0442\u0435
    2 \u0441\u0435\u043A\u0443\u043D\u0434\u044B."
  checksHeader: "\u0427\u0442\u043E \u043F\u0440\u043E\u0432\u0435\u0440\u0438\u0442\u044C"
  checks:
  - "\u041E\u0442\u043A\u0440\u044B\u0442\u0438\u0435 \u043A\u043B\u0430\u043F\u0430\u043D\u043E\u0432
    (\u043F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u043F\u043B\u0430\u0441\u0442\u0438\u043D)"
  - "\u041F\u043E\u043B\u043E\u0436\u0435\u043D\u0438\u0435 \u0448\u0442\u043E\u043A\u043E\u0432
    \u0442\u0430\u0440\u0435\u043B\u043E\u043A"
  - "\u0426\u0435\u043B\u043E\u0441\u0442\u043D\u043E\u0441\u0442\u044C \u0443\u0437\u043B\u043E\u0432
