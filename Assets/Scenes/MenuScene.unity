  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u0414\u043B\u044F \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B
    \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0441 \u043C\u0435\u043D\u044E, \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u043D\u0430\u0436\u0430\u0442\u044C \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C
    \u0431\u043E\u043A\u043E\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443
    \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0430, \u043F\u0440\u0438
    \u044D\u0442\u043E\u043C \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F \u043B\u0443\u0447.
    \u041B\u0443\u0447 \u043C\u043E\u0436\u043D\u043E \u043D\u0430\u0432\u043E\u0434\u0438\u0442\u044C
    \u043D\u0430 \u0442\u0435 \u043E\u0431\u044A\u0435\u043A\u0442\u044B \u0441 \u043A\u043E\u0442\u043E\u0440\u044B\u043C\u0438
    \u0445\u043E\u0447\u0435\u0448\u044C \u0432\u0437\u0430\u0438\u043C\u043E\u0434\u0435\u0439\u0441\u0442\u0432\u043E\u0432\u0430\u0442\u044C
    \u0435\u0441\u043B\u0438 \u043E\u043D\u0438 \u0438\u043D\u0442\u0435\u0440\u0430\u043A\u0442\u0438\u0432\u043D\u044B\u0435,
    \u0442\u043E \u043B\u0443\u0447 \u043F\u043E\u043C\u0435\u043D\u044F\u0435\u0442
    \u0446\u0432\u0435\u0442. \u041F\u043E\u0441\u043B\u0435 \u044D\u0442\u043E\u0433\u043E
    \u043D\u0430\u0436\u043C\u0438 \u043A\u0443\u0440\u043E\u043A, \u043F\u0440\u043E\u0438\u0437\u043E\u0439\u0434\u0435\u0442
    \u043C\u0430\u0433\u0438\u044F..."
