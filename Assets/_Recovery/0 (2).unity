    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0414\u043B\u044F \u0442\u043E\u0433\u043E \u0447\u0442\u043E\u0431\u044B
    \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C\u0441\u044F
    \u043F\u043E \u043B\u043E\u043A\u0430\u0446\u0438\u0438, \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u043D\u0430 \u043B\u0435\u0432\u043E\u043C \u043A\u043E\u043D\u0442\u0440\u043E\u043B\u043B\u0435\u0440\u0435
    \u043D\u0430\u0436\u0430\u0442\u044C \u0438 \u0443\u0434\u0435\u0440\u0436\u0438\u0432\u0430\u0442\u044C
    \u0431\u043E\u043A\u043E\u0432\u0443\u044E \u043A\u043D\u043E\u043F\u043A\u0443.
    \u0418\u0437 \u0440\u0443\u043A\u0438 \u043F\u043E\u044F\u0432\u0438\u0442\u0441\u044F
    \u043B\u0443\u0447 \u0432 \u0432\u0438\u0434\u0435 \u0434\u0443\u0433\u0438.
    \u041B\u0443\u0447 \u043D\u0435\u043E\u0431\u0445\u043E\u0434\u0438\u043C\u043E
    \u043D\u0430\u043F\u0440\u0430\u0432\u0438\u0442\u044C \u0432 \u0442\u043E \u043C\u0435\u0441\u0442\u043E
    \u043A\u0443\u0434\u0430 \u0432\u044B \u0445\u043E\u0442\u0438\u0442\u0435 \u043F\u0435\u0440\u0435\u043C\u0435\u0441\u0442\u0438\u0442\u044C\u0441\u044F
    \u0438 \u043E\u0442\u043F\u0443\u0441\u0442\u0438\u0442\u044C \u0431\u043E\u043A\u043E\u0432\u0443\u044E
    \u043A\u043D\u043E\u043F\u043A\u0443 \u0438 \u0432\u044B \u0442\u0435\u043B\u0435\u043F\u043E\u0440\u0442\u0438\u0440\u0443\u0435\u0442\u0435\u0441\u044C
    \u0432 \u043D\u0443\u0436\u043D\u043E\u0435 \u043C\u0435\u0441\u0442\u043E."
